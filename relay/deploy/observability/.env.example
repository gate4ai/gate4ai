# Скопируйте в .env (не коммитится) и поправьте.
GRAFANA_DOMAIN=grafana.gate4.ai
GRAFANA_ADMIN_USER=admin
# acme — Let's Encrypt (прод); internal — самоподписанный CA Caddy (локальная проверка).
GRAFANA_TLS=acme
# Сайт gate4.ai за этим же Caddy (сертификат на WWW_DOMAIN и www.WWW_DOMAIN).
WWW_DOMAIN=gate4.ai
WWW_TLS=acme

# Ретенция.
METRICS_RETENTION=15d
METRICS_RETENTION_SIZE=2GB
LOGS_RETENTION=168h
TRACES_RETENTION=72h

# Лимиты памяти контейнеров (в сумме ~1.4 ГБ на пике; обычно заметно меньше).
PROMETHEUS_MEM=256m
LOKI_MEM=256m
TEMPO_MEM=256m
GRAFANA_MEM=320m
ALLOY_MEM=192m
CADDY_MEM=64m
NODE_EXPORTER_MEM=48m
